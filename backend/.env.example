# === WAJIB COPY jadi backend/.env lalu isi nilai aslinya ===
# JANGAN PERNAH commit file backend/.env ke git

# --- ENV ---
# development | production — kalau production, AUTH_SECRET_KEY & SYNC_SECRET wajib terisi
ENV=development

# --- LLM ---
# "auto" | "openrouter" | "groq" | "ollama"
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_FALLBACK_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- AUTH (WAJIB di production) ---
# Generate: openssl rand -hex 32  (Windows: python -c "import secrets; print(secrets.token_hex(32))")
AUTH_SECRET_KEY=ganti-dengan-string-acak-min-32-char-contoh-openssl-rand-hex-32
ADMIN_EMAIL=admin@belajaradaptif.local
ADMIN_PASSWORD=ganti-password-kuat-min-12-karakter

# --- CORS ---
# Daftar origin frontend yang boleh akses API (pisah koma tanpa spasi)
# Contoh production: ALLOWED_ORIGINS=https://belajaradaptif.com,https://www.belajaradaptif.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SYNC OBSIDIAN (WAJIB di production, kalau kosong endpoint sync akan reject) ---
SYNC_SECRET=ganti-dengan-token-acak-min-20-char
VAULT_INDEX_PATH=vault_index.json

# --- DATABASE ---
# Path absolut lebih aman untuk Docker/production
DB_PATH=belajar.db

# --- UPLOAD ---
UPLOAD_DIR=uploads/avatars
GAMBAR_DIR=uploads/gambar

# --- IMAGE ---
IMAGE_PROVIDER=auto
IMAGE_GEN_ENABLED=true
IMAGE_GEN_TIMEOUT_SECONDS=12
IMAGE_GEN_RATE_LIMIT_PER_HOUR=20
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_KEY_2=
